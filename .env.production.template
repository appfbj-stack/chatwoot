# Kairos CRM — .env.production
# Aplicar no container: docker-compose com env_file: .env.production

# ============================================
# Branding
# ============================================
RAILS_ENV=production
INSTALLATION_NAME=Kairos CRM
BRAND_NAME=Kairos CRM
BRAND_URL=https://chat.fbautomacao.space
WIDGET_BRAND_URL=https://chat.fbautomacao.space
TERMS_URL=https://chat.fbautomacao.space/terms-of-service
PRIVACY_URL=https://chat.fbautomacao.space/privacy-policy
LOGO=/brand-assets/logo.svg
LOGO_DARK=/brand-assets/logo_dark.svg
LOGO_THUMBNAIL=/brand-assets/logo_thumbnail.svg

# Frontend
FRONTEND_URL=https://chat.fbautomacao.space

# ============================================
# Database (aponta pro kairos-shared-pg)
# ============================================
DATABASE_URL=postgresql://chatwoot_user:CHANGE_ME@kairos-shared-pg:5432/chatwoot_db
RAILS_MAX_THREADS=5
POSTGRES_STATEMENT_TIMEOUT=60000

# ============================================
# Redis
# ============================================
REDIS_URL=redis://kairos-redis:6379/0
REDIS_PASSWORD=

# ============================================
# Rails secrets (gerar com `rails secret`)
# ============================================
SECRET_KEY_BASE=CHANGE_ME_GENERATE_WITH_RAILS_SECRET
RAILS_MASTER_KEY=CHANGE_ME_FROM_CONFIG_MASTER_KEY

# ============================================
# Email (SMTP)
# ============================================
MAILER_SENDER_EMAIL=no-reply@fbautomacao.space
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=fbautomacao.space
SMTP_USERNAME=no-reply@fbautomacao.space
SMTP_PASSWORD=CHANGE_ME
SMTP_ENABLE_STARTTLS_AUTO=true

# ============================================
# Kairos Agent (MiniMax — substituiu Captain OpenAI)
# ============================================
KAIROS_AGENT_PROVIDER=minimax
KAIROS_AGENT_API_KEY=REPLACE_ME_WITH_MINIMAX_KEY
KAIROS_AGENT_MODEL=minimax-m-2
KAIROS_AGENT_ENDPOINT=https://api.minimax.com/v1
KAIROS_AGENT_MAX_TOKENS=4096
KAIROS_AGENT_TEMPERATURE=0.7
KAIROS_AGENT_SYSTEM_PROMPT=Voce e o agente Kairos, assistente de atendimento da plataforma Kairos CRM. Responda em portugues brasileiro de forma clara, objetiva e amigavel. Use tom profissional mas acolhedor. Quando nao souber a resposta, transfira para um humano.

# Manter compatibilidade Captain (opcional, pode remover)
CAPTAIN_OPEN_AI_API_KEY=
CAPTAIN_OPEN_AI_MODEL=
CAPTAIN_OPEN_AI_ENDPOINT=

# ============================================
# Wazapi (WhatsApp API self-hosted)
# ============================================
WAZAPI_BASE_URL=http://kairos-wazapi:8080
WAZAPI_INSTANCE_ID=REPLACE_ME
WAZAPI_TOKEN=REPLACE_ME
WAZAPI_WEBHOOK_SECRET=REPLACE_ME_RANDOM_TOKEN
WAZAPI_TIMEOUT=30

# ============================================
# Storage (ActiveStorage) — local
# ============================================
ACTIVE_STORAGE_SERVICE=local

# ============================================
# Misc
# ============================================
ENABLE_ACCOUNT_SIGNUP=false
CREATE_NEW_ACCOUNT_FROM_DASHBOARD=false
DISABLE_TELEMETRY=true
RACK_ATTACK_ENABLED=true
SENDGRID_API_KEY=
